# Supabase: Project Settings -> API
# Use the browser-safe publishable key. Never put a service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Geoapify: My Projects -> API Keys
# Used for place/destination autocomplete and map tiles.
VITE_GEOAPIFY_API_KEY=

# Optional, verified operator/contact details for the existing privacy page
VITE_PRIVACY_OPERATOR_NAME=
VITE_PRIVACY_CONTACT_EMAIL=
