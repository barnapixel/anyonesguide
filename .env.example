# Supabase: Project Settings -> API
# Use the browser-safe publishable key. Never put a service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Geoapify: My Projects -> API Keys
# Used for place/destination autocomplete and map tiles.
VITE_GEOAPIFY_API_KEY=

# Optional, verified operator/contact details for the existing privacy page
VITE_PRIVACY_OPERATOR_NAME=
VITE_PRIVACY_CONTACT_EMAIL=

# Server only, Netlify Functions scope. Never prefix these with VITE_.
# Enable after setting a Gemini key with billing and appropriate data terms.
GEMINI_API_KEY=
RECOMMENDATION_IMPORT_ENABLED=false
# Optional override; default gemini-3.8-flash
GEMINI_IMPORT_MODEL=
